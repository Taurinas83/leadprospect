// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("member") // "manager" or "member"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  company     String   @default("")
  email       String?
  phone       String?
  whatsapp    String?
  website     String?
  instagram   String?
  linkedin    String?
  address     String?
  niche       String?
  leadType    String   @default("pessoa_juridica") // "pessoa_juridica" or "pessoa_fisica"
  status      String   @default("novo")
  source      String?  @default("manual")
  score       Int      @default(0)
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchHistory {
  id          String   @id @default(cuid())
  query       String
  niche       String?
  location    String?
  leadType    String?
  results     Int      @default(0)
  createdAt   DateTime @default(now())
}
